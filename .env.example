# Copy to .env and fill in the credentials supplied by the organizers.
# OPENAI_* names match vendor/baseline.py; the provider here is Qwen.
OPENAI_API_KEY=
# Base URL from the organizer's example and model page.
OPENAI_BASE_URL=https://inference.airi.net/v1
# Model ID observed in the organizer's model page.
OPENAI_MODEL=Qwen/Qwen3.8-27B
QWEN_TIMEOUT_SECONDS=90
QWEN_MAX_TOKENS=6144
