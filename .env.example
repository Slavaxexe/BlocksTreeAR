# Copy to .env and fill in the credentials supplied by the organizers.
# OPENAI_* names match baseline/baseline.py; the provider here is Qwen.
OPENAI_API_KEY=
# Proxy and model from the current organizer instructions.
OPENAI_BASE_URL=https://changellenge.up.railway.app/v1
OPENAI_MODEL=qwen/qwen3.8-27b
# 0 disables the local cap; the provider/platform can still impose limits.
QWEN_TIMEOUT_SECONDS=0
QWEN_MAX_TOKENS=0
