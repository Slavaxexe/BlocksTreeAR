# Copy to .env and fill in the credentials supplied by the organizers.
# The platform injects OPENAI_API_KEY and OPENAI_BASE_URL at evaluation.
OPENAI_API_KEY=
# Official proxy for local development; the code reads the address from the environment.
OPENAI_BASE_URL=https://changellenge.up.railway.app/v1
# Optional: this is also the application's default model.
OPENAI_MODEL=qwen/qwen3.8-27b
QWEN_TIMEOUT_SECONDS=600
QWEN_MAX_TOKENS=32768
