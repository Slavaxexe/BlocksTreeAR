{
  "$defs": {
    "DataFiles": {
      "additionalProperties": false,
      "properties": {
        "train_file": {
          "minLength": 1,
          "title": "Train File",
          "type": "string"
        },
        "test_file": {
          "minLength": 1,
          "title": "Test File",
          "type": "string"
        },
        "sample_submission_file": {
          "minLength": 1,
          "title": "Sample Submission File",
          "type": "string"
        },
        "id_column": {
          "minLength": 1,
          "title": "Id Column",
          "type": "string"
        }
      },
      "required": [
        "train_file",
        "test_file",
        "sample_submission_file",
        "id_column"
      ],
      "title": "DataFiles",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "rmse",
            "macro_f1"
          ],
          "title": "Name",
          "type": "string"
        },
        "direction": {
          "enum": [
            "minimize",
            "maximize"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "name",
        "direction"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Problem": {
      "additionalProperties": false,
      "properties": {
        "task_type": {
          "enum": [
            "regression",
            "classification"
          ],
          "title": "Task Type",
          "type": "string"
        },
        "target_column": {
          "minLength": 1,
          "title": "Target Column",
          "type": "string"
        }
      },
      "required": [
        "task_type",
        "target_column"
      ],
      "title": "Problem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "problem": {
      "$ref": "#/$defs/Problem"
    },
    "data": {
      "$ref": "#/$defs/DataFiles"
    },
    "metric": {
      "$ref": "#/$defs/Metric"
    }
  },
  "required": [
    "problem",
    "data",
    "metric"
  ],
  "title": "Task",
  "type": "object"
}
