{
  "$defs": {
    "Assembly": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        },
        "write_blocks": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Write Blocks",
          "type": "array"
        }
      },
      "required": [
        "blocks",
        "write_blocks"
      ],
      "title": "Assembly",
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "source_node": {
          "anyOf": [
            {
              "pattern": "^node_[0-9]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Node"
        },
        "description": {
          "description": "Behavior and exact input/output types, shapes, column conventions and object APIs",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "requires": {
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        },
        "provides": {
          "description": "Required non-None state outputs; nullable settings belong inside output objects",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Provides",
          "type": "array"
        }
      },
      "required": [
        "name",
        "description",
        "provides"
      ],
      "title": "Block",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "expected_effect": {
          "minLength": 1,
          "title": "Expected Effect",
          "type": "string"
        },
        "pipeline": {
          "$ref": "#/$defs/Pipeline"
        },
        "research_ids": {
          "items": {
            "type": "string"
          },
          "title": "Research Ids",
          "type": "array"
        }
      },
      "required": [
        "rationale",
        "expected_effect",
        "pipeline"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "Pipeline": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "title": "Data",
          "type": "object"
        },
        "preprocessing": {
          "title": "Preprocessing",
          "type": "object"
        },
        "model": {
          "title": "Model",
          "type": "object"
        },
        "training": {
          "title": "Training",
          "type": "object"
        }
      },
      "required": [
        "data",
        "preprocessing",
        "model",
        "training"
      ],
      "title": "Pipeline",
      "type": "object"
    },
    "Proposal": {
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "enum": [
            "baseline",
            "improve",
            "explore"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^node_[0-9]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "hypothesis": {
          "$ref": "#/$defs/Hypothesis"
        },
        "assembly": {
          "$ref": "#/$defs/Assembly"
        }
      },
      "required": [
        "purpose",
        "hypothesis",
        "assembly"
      ],
      "title": "Proposal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "proposals": {
      "items": {
        "$ref": "#/$defs/Proposal"
      },
      "minItems": 1,
      "title": "Proposals",
      "type": "array"
    }
  },
  "required": [
    "proposals"
  ],
  "title": "Proposals",
  "type": "object"
}
