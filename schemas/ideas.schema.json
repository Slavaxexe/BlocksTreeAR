{
  "$defs": {
    "Idea": {
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "enum": [
            "baseline",
            "improve",
            "explore"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^node_[0-9]{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "change": {
          "description": "One concrete change, including intended algorithm or parameters",
          "minLength": 1,
          "title": "Change",
          "type": "string"
        },
        "change_blocks": {
          "description": "Existing or proposed block names to change",
          "items": {
            "type": "string"
          },
          "title": "Change Blocks",
          "type": "array"
        },
        "expected_effect": {
          "minLength": 1,
          "title": "Expected Effect",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "change",
        "expected_effect"
      ],
      "title": "Idea",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ideas": {
      "items": {
        "$ref": "#/$defs/Idea"
      },
      "minItems": 1,
      "title": "Ideas",
      "type": "array"
    }
  },
  "required": [
    "ideas"
  ],
  "title": "Ideas",
  "type": "object"
}
