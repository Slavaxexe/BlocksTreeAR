{
  "$defs": {
    "Idea": {
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "enum": [
            "baseline",
            "improve",
            "explore"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^node_[0-9]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "change": {
          "description": "One concrete change, including intended algorithm or parameters",
          "minLength": 1,
          "title": "Change",
          "type": "string"
        },
        "change_blocks": {
          "description": "Existing or proposed block names to change",
          "items": {
            "type": "string"
          },
          "title": "Change Blocks",
          "type": "array"
        },
        "expected_effect": {
          "minLength": 1,
          "title": "Expected Effect",
          "type": "string"
        },
        "priority": {
          "default": 50,
          "description": "Queue priority; higher runs first, not an expected score",
          "maximum": 100,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "research_ids": {
          "description": "IDs of only the research insights needed for this change; empty when unrelated",
          "items": {
            "type": "string"
          },
          "title": "Research Ids",
          "type": "array"
        }
      },
      "required": [
        "purpose",
        "change",
        "expected_effect"
      ],
      "title": "Idea",
      "type": "object"
    },
    "IdeaUpdate": {
      "additionalProperties": false,
      "properties": {
        "idea_id": {
          "title": "Idea Id",
          "type": "string"
        },
        "action": {
          "enum": [
            "prioritize",
            "remove"
          ],
          "title": "Action",
          "type": "string"
        },
        "priority": {
          "default": 50,
          "maximum": 100,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "idea_id",
        "action",
        "reason"
      ],
      "title": "IdeaUpdate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ideas": {
      "items": {
        "$ref": "#/$defs/Idea"
      },
      "title": "Ideas",
      "type": "array"
    },
    "updates": {
      "items": {
        "$ref": "#/$defs/IdeaUpdate"
      },
      "title": "Updates",
      "type": "array"
    }
  },
  "title": "Ideas",
  "type": "object"
}
