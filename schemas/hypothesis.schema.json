{
  "$defs": {
    "Dummy": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "dummy",
          "default": "dummy",
          "title": "Family",
          "type": "string"
        }
      },
      "title": "Dummy",
      "type": "object"
    },
    "ExtraTrees": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "extra_trees",
          "default": "extra_trees",
          "title": "Family",
          "type": "string"
        },
        "n_estimators": {
          "default": 64,
          "maximum": 160,
          "minimum": 16,
          "title": "N Estimators",
          "type": "integer"
        },
        "max_depth": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 16,
          "title": "Max Depth"
        },
        "min_samples_leaf": {
          "default": 1,
          "maximum": 64,
          "minimum": 1,
          "title": "Min Samples Leaf",
          "type": "integer"
        },
        "class_weight": {
          "default": "none",
          "enum": [
            "none",
            "balanced"
          ],
          "title": "Class Weight",
          "type": "string"
        }
      },
      "title": "ExtraTrees",
      "type": "object"
    },
    "HistBoosting": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "hist_gradient_boosting",
          "default": "hist_gradient_boosting",
          "title": "Family",
          "type": "string"
        },
        "max_iter": {
          "default": 80,
          "maximum": 200,
          "minimum": 20,
          "title": "Max Iter",
          "type": "integer"
        },
        "max_leaf_nodes": {
          "default": 15,
          "maximum": 63,
          "minimum": 3,
          "title": "Max Leaf Nodes",
          "type": "integer"
        },
        "learning_rate": {
          "default": 0.1,
          "maximum": 0.3,
          "minimum": 0.01,
          "title": "Learning Rate",
          "type": "number"
        },
        "l2_regularization": {
          "default": 1.0,
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "L2 Regularization",
          "type": "number"
        }
      },
      "title": "HistBoosting",
      "type": "object"
    },
    "Pipeline": {
      "additionalProperties": false,
      "properties": {
        "preprocessing": {
          "$ref": "#/$defs/Preprocessing"
        },
        "model": {
          "discriminator": {
            "mapping": {
              "dummy": "#/$defs/Dummy",
              "extra_trees": "#/$defs/ExtraTrees",
              "hist_gradient_boosting": "#/$defs/HistBoosting"
            },
            "propertyName": "family"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Dummy"
            },
            {
              "$ref": "#/$defs/ExtraTrees"
            },
            {
              "$ref": "#/$defs/HistBoosting"
            }
          ],
          "title": "Model"
        }
      },
      "required": [
        "model"
      ],
      "title": "Pipeline",
      "type": "object"
    },
    "Preprocessing": {
      "additionalProperties": false,
      "properties": {
        "numeric_imputer": {
          "default": "median",
          "enum": [
            "median",
            "mean"
          ],
          "title": "Numeric Imputer",
          "type": "string"
        },
        "categorical_encoder": {
          "const": "ordinal",
          "default": "ordinal",
          "title": "Categorical Encoder",
          "type": "string"
        },
        "missing_indicators": {
          "default": false,
          "title": "Missing Indicators",
          "type": "boolean"
        },
        "augmentation": {
          "const": "none",
          "default": "none",
          "title": "Augmentation",
          "type": "string"
        }
      },
      "title": "Preprocessing",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "rationale": {
      "maxLength": 1600,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "expected_effect": {
      "maxLength": 800,
      "minLength": 1,
      "title": "Expected Effect",
      "type": "string"
    },
    "pipeline": {
      "$ref": "#/$defs/Pipeline"
    }
  },
  "required": [
    "rationale",
    "expected_effect",
    "pipeline"
  ],
  "title": "Hypothesis",
  "type": "object"
}
