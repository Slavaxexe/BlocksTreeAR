{
  "$defs": {
    "DataBinding": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Input roles to paths relative to the task directory",
          "title": "Files",
          "type": "object"
        },
        "target_columns": {
          "items": {
            "type": "string"
          },
          "title": "Target Columns",
          "type": "array"
        },
        "id_columns": {
          "items": {
            "type": "string"
          },
          "title": "Id Columns",
          "type": "array"
        },
        "query_columns": {
          "description": "Ranking query key; never the document ID",
          "items": {
            "type": "string"
          },
          "title": "Query Columns",
          "type": "array"
        },
        "time_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ordered observation time for forecasting",
          "title": "Time Column"
        },
        "series_columns": {
          "description": "Forecast series key; [] means one series",
          "items": {
            "type": "string"
          },
          "title": "Series Columns",
          "type": "array"
        }
      },
      "required": [
        "files"
      ],
      "title": "DataBinding",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "minimize",
                "maximize"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "definition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Definition"
        },
        "parameters": {
          "description": "Explicit metric semantics: top_k, gain=linear/exponential for NDCG, average for classification, rmse_aggregation=global/mean_target_rmse",
          "title": "Parameters",
          "type": "object"
        },
        "status": {
          "default": "needs_implementation",
          "enum": [
            "ready",
            "needs_implementation"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "Metric",
      "type": "object"
    },
    "OutputBinding": {
      "additionalProperties": false,
      "properties": {
        "filename": {
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "class_columns": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "description": "Optional target -> class label -> probability output column for multi-output classification",
          "title": "Class Columns",
          "type": "object"
        }
      },
      "required": [
        "filename"
      ],
      "title": "OutputBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "ready",
        "partial",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "extraction": {
      "default": "extraction.json",
      "title": "Extraction",
      "type": "string"
    },
    "task_directory": {
      "title": "Task Directory",
      "type": "string"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/DataBinding"
    },
    "validation": {
      "title": "Validation",
      "type": "object"
    },
    "metric": {
      "$ref": "#/$defs/Metric"
    },
    "output": {
      "$ref": "#/$defs/OutputBinding"
    },
    "profile": {
      "title": "Profile",
      "type": "object"
    },
    "source_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Source Hashes",
      "type": "object"
    },
    "code_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Code Sha256",
      "type": "string"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "task_directory",
    "rationale",
    "data",
    "validation",
    "metric",
    "output",
    "code_sha256"
  ],
  "title": "Preparation",
  "type": "object"
}
