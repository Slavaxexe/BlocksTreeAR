{
  "$defs": {
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "minimize",
                "maximize"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "definition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Definition"
        },
        "status": {
          "default": "needs_implementation",
          "enum": [
            "ready",
            "needs_implementation"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "Metric",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "node_id": {
      "default": "node_000",
      "pattern": "^node_[0-9]{3}$",
      "title": "Node Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "timeout"
      ],
      "title": "Status",
      "type": "string"
    },
    "metric": {
      "$ref": "#/$defs/Metric"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    },
    "evaluation_status": {
      "default": "unavailable",
      "enum": [
        "completed",
        "unavailable",
        "failed"
      ],
      "title": "Evaluation Status",
      "type": "string"
    },
    "duration_seconds": {
      "minimum": 0.0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "preparation_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Preparation Sha256",
      "type": "string"
    },
    "code_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Code Sha256",
      "type": "string"
    },
    "validation_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation File"
    },
    "submission_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submission File"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "status",
    "metric",
    "duration_seconds",
    "preparation_sha256",
    "code_sha256"
  ],
  "title": "Finish",
  "type": "object"
}
