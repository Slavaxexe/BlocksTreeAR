{
  "$defs": {
    "Assembly": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        },
        "write_blocks": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Write Blocks",
          "type": "array"
        }
      },
      "required": [
        "blocks",
        "write_blocks"
      ],
      "title": "Assembly",
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "source_node": {
          "anyOf": [
            {
              "pattern": "^node_[0-9]{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Node"
        },
        "description": {
          "description": "Behavior and exact input/output types, shapes, column conventions and object APIs",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "requires": {
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        },
        "provides": {
          "description": "Required non-None state outputs; nullable settings belong inside output objects",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Provides",
          "type": "array"
        }
      },
      "required": [
        "name",
        "description",
        "provides"
      ],
      "title": "Block",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "expected_effect": {
          "minLength": 1,
          "title": "Expected Effect",
          "type": "string"
        },
        "pipeline": {
          "$ref": "#/$defs/Pipeline"
        }
      },
      "required": [
        "rationale",
        "expected_effect",
        "pipeline"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "Pipeline": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "title": "Data",
          "type": "object"
        },
        "preprocessing": {
          "title": "Preprocessing",
          "type": "object"
        },
        "model": {
          "title": "Model",
          "type": "object"
        },
        "training": {
          "title": "Training",
          "type": "object"
        }
      },
      "required": [
        "data",
        "preprocessing",
        "model",
        "training"
      ],
      "title": "Pipeline",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 5,
      "enum": [
        4,
        5
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "node_id": {
      "default": "node_000",
      "pattern": "^node_[0-9]{3,}$",
      "title": "Node Id",
      "type": "string"
    },
    "parent_id": {
      "anyOf": [
        {
          "pattern": "^node_[0-9]{3,}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Id"
    },
    "source": {
      "const": "qwen",
      "default": "qwen",
      "title": "Source",
      "type": "string"
    },
    "preparation": {
      "default": "../../preparation.json",
      "title": "Preparation",
      "type": "string"
    },
    "preparation_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Preparation Sha256",
      "type": "string"
    },
    "context": {
      "title": "Context",
      "type": "object"
    },
    "purpose": {
      "enum": [
        "baseline",
        "improve",
        "explore"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "hypothesis": {
      "$ref": "#/$defs/Hypothesis"
    },
    "assembly": {
      "$ref": "#/$defs/Assembly"
    },
    "implementation": {
      "default": "experiment.py",
      "title": "Implementation",
      "type": "string"
    },
    "outputs": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Outputs",
      "type": "object"
    },
    "timeout_seconds": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timeout Seconds"
    }
  },
  "required": [
    "preparation_sha256",
    "purpose",
    "hypothesis",
    "assembly",
    "outputs"
  ],
  "title": "Start",
  "type": "object"
}
