{
  "$defs": {
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "expected_effect": {
          "minLength": 1,
          "title": "Expected Effect",
          "type": "string"
        },
        "pipeline": {
          "$ref": "#/$defs/Pipeline"
        }
      },
      "required": [
        "rationale",
        "expected_effect",
        "pipeline"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "Implementation": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "default": "experiment.py",
          "title": "File",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256"
      ],
      "title": "Implementation",
      "type": "object"
    },
    "Pipeline": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "title": "Data",
          "type": "object"
        },
        "preprocessing": {
          "title": "Preprocessing",
          "type": "object"
        },
        "model": {
          "title": "Model",
          "type": "object"
        },
        "training": {
          "title": "Training",
          "type": "object"
        }
      },
      "required": [
        "data",
        "preprocessing",
        "model",
        "training"
      ],
      "title": "Pipeline",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "node_id": {
      "default": "node_000",
      "pattern": "^node_[0-9]{3}$",
      "title": "Node Id",
      "type": "string"
    },
    "parent_id": {
      "anyOf": [
        {
          "pattern": "^node_[0-9]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Id"
    },
    "source": {
      "const": "qwen",
      "default": "qwen",
      "title": "Source",
      "type": "string"
    },
    "preparation": {
      "default": "../../preparation.json",
      "title": "Preparation",
      "type": "string"
    },
    "preparation_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Preparation Sha256",
      "type": "string"
    },
    "hypothesis": {
      "$ref": "#/$defs/Hypothesis"
    },
    "implementation": {
      "$ref": "#/$defs/Implementation"
    },
    "outputs": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Outputs",
      "type": "object"
    },
    "timeout_seconds": {
      "exclusiveMinimum": 0.0,
      "title": "Timeout Seconds",
      "type": "number"
    }
  },
  "required": [
    "preparation_sha256",
    "hypothesis",
    "implementation",
    "outputs",
    "timeout_seconds"
  ],
  "title": "Start",
  "type": "object"
}
