{
  "$defs": {
    "PreparationRecipe": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "margo",
          "default": "margo",
          "title": "Provider",
          "type": "string"
        },
        "source_root": {
          "title": "Source Root",
          "type": "string"
        },
        "recipe": {
          "title": "Recipe",
          "type": "string"
        },
        "split": {
          "title": "Split",
          "type": "string"
        },
        "source_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Source Hashes",
          "type": "object"
        },
        "feature_names": {
          "items": {
            "type": "string"
          },
          "title": "Feature Names",
          "type": "array"
        }
      },
      "required": [
        "source_root",
        "recipe",
        "split",
        "source_hashes"
      ],
      "title": "PreparationRecipe",
      "type": "object"
    },
    "SelectedModel": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "enum": [
            "ridge",
            "huber_linear",
            "logistic_regression",
            "knn",
            "elasticnet",
            "sgd",
            "random_forest",
            "extra_trees",
            "hist_gradient_boosting",
            "lightgbm",
            "catboost",
            "xgboost",
            "mlp",
            "flaml",
            "autogluon"
          ],
          "title": "Family",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "parameters": {
          "title": "Parameters",
          "type": "object"
        },
        "target_transform": {
          "default": "none",
          "enum": [
            "none",
            "log1p"
          ],
          "title": "Target Transform",
          "type": "string"
        },
        "selection_metadata": {
          "title": "Selection Metadata",
          "type": "object"
        }
      },
      "required": [
        "family"
      ],
      "title": "SelectedModel",
      "type": "object"
    },
    "SubmissionSpec": {
      "additionalProperties": false,
      "properties": {
        "filename": {
          "default": "submission.csv",
          "title": "Filename",
          "type": "string"
        },
        "prediction_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prediction Column"
        },
        "prediction_type": {
          "default": "labels",
          "enum": [
            "labels",
            "probability"
          ],
          "title": "Prediction Type",
          "type": "string"
        },
        "positive_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Positive Label"
        }
      },
      "title": "SubmissionSpec",
      "type": "object"
    },
    "TrainingFiles": {
      "additionalProperties": false,
      "properties": {
        "train": {
          "title": "Train",
          "type": "string"
        },
        "test": {
          "title": "Test",
          "type": "string"
        },
        "sample_submission": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Submission"
        }
      },
      "required": [
        "train",
        "test"
      ],
      "title": "TrainingFiles",
      "type": "object"
    },
    "ValidationConstraints": {
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "default": "random",
          "enum": [
            "random",
            "group",
            "time"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "group_columns": {
          "items": {
            "type": "string"
          },
          "title": "Group Columns",
          "type": "array"
        },
        "time_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Column"
        }
      },
      "title": "ValidationConstraints",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_type": {
      "default": "regression",
      "enum": [
        "regression",
        "classification"
      ],
      "title": "Task Type",
      "type": "string"
    },
    "files": {
      "$ref": "#/$defs/TrainingFiles"
    },
    "target": {
      "title": "Target",
      "type": "string"
    },
    "id_columns": {
      "items": {
        "type": "string"
      },
      "title": "Id Columns",
      "type": "array"
    },
    "primary_metric": {
      "enum": [
        "rmse",
        "mae",
        "mse",
        "r2",
        "mape",
        "f1_macro",
        "f1_weighted",
        "accuracy",
        "balanced_accuracy",
        "f1",
        "roc_auc",
        "log_loss"
      ],
      "title": "Primary Metric",
      "type": "string"
    },
    "selected_models": {
      "items": {
        "$ref": "#/$defs/SelectedModel"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Selected Models",
      "type": "array"
    },
    "eda": {
      "title": "Eda",
      "type": "object"
    },
    "validation_constraints": {
      "$ref": "#/$defs/ValidationConstraints"
    },
    "submission": {
      "$ref": "#/$defs/SubmissionSpec"
    },
    "preparation": {
      "anyOf": [
        {
          "$ref": "#/$defs/PreparationRecipe"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outer_split": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outer Split"
    }
  },
  "required": [
    "files",
    "target",
    "primary_metric",
    "selected_models"
  ],
  "title": "TrainingInput",
  "type": "object"
}
