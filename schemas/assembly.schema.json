{
  "$defs": {
    "Block": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCall"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "source_node": {
          "anyOf": [
            {
              "pattern": "^node_[0-9]{3,}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Node"
        },
        "description": {
          "description": "Behavior and exact input/output types, shapes, column conventions and object APIs",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "requires": {
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        },
        "provides": {
          "description": "Required non-None state outputs; nullable settings belong inside output objects",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Provides",
          "type": "array"
        }
      },
      "required": [
        "name",
        "description",
        "provides"
      ],
      "title": "Block",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "constant",
            "features",
            "preprocess",
            "fit",
            "predict",
            "automl",
            "ensemble",
            "saved_ensemble",
            "forecast"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parameters": {
          "title": "Parameters",
          "type": "object"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Map canonical operation inputs to saved state keys",
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Map canonical outputs to custom state keys",
          "title": "Outputs",
          "type": "object"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ToolCall",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "items": {
        "$ref": "#/$defs/Block"
      },
      "minItems": 1,
      "title": "Blocks",
      "type": "array"
    },
    "write_blocks": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Write Blocks",
      "type": "array"
    }
  },
  "required": [
    "blocks",
    "write_blocks"
  ],
  "title": "Assembly",
  "type": "object"
}
