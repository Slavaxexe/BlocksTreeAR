{
  "additionalProperties": false,
  "properties": {
    "name": {
      "pattern": "^[a-zA-Z0-9_-]{1,50}$",
      "title": "Name",
      "type": "string"
    },
    "model_index": {
      "minimum": 0,
      "title": "Model Index",
      "type": "integer"
    },
    "parameters": {
      "title": "Parameters",
      "type": "object"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "optimizer": {
      "default": "not_applicable",
      "title": "Optimizer",
      "type": "string"
    },
    "regularization": {
      "default": "engine/model defaults",
      "title": "Regularization",
      "type": "string"
    },
    "estimated_seconds": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Estimated wall time for this complete trial, including CV and worker startup",
      "title": "Estimated Seconds"
    }
  },
  "required": [
    "name",
    "model_index",
    "rationale"
  ],
  "title": "TrainingCandidate",
  "type": "object"
}
