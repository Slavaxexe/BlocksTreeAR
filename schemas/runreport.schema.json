{
  "$defs": {
    "LLMCall": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "title": "Role",
          "type": "string"
        },
        "node_id": {
          "anyOf": [
            {
              "pattern": "^(node|research)_[0-9]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "status": {
          "enum": [
            "completed",
            "invalid_json",
            "api_error"
          ],
          "title": "Status",
          "type": "string"
        },
        "prompt_tokens": {
          "default": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "completion_tokens": {
          "default": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "role",
        "attempt",
        "status"
      ],
      "title": "LLMCall",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "running",
        "ready",
        "partial",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "stage": {
      "default": "extraction",
      "enum": [
        "extraction",
        "preparation",
        "baseline",
        "search",
        "finalization",
        "complete"
      ],
      "title": "Stage",
      "type": "string"
    },
    "mode": {
      "const": "qwen",
      "default": "qwen",
      "title": "Mode",
      "type": "string"
    },
    "task_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Task Sha256",
      "type": "string"
    },
    "checks": {
      "items": {
        "type": "string"
      },
      "title": "Checks",
      "type": "array"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "llm_calls": {
      "items": {
        "$ref": "#/$defs/LLMCall"
      },
      "title": "Llm Calls",
      "type": "array"
    },
    "stop_reason": {
      "anyOf": [
        {
          "enum": [
            "node_limit",
            "time_budget",
            "llm_error",
            "preparation_failed",
            "baseline_failed",
            "error"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "completed_nodes": {
      "default": 0,
      "minimum": 0,
      "title": "Completed Nodes",
      "type": "integer"
    },
    "failed_nodes": {
      "default": 0,
      "minimum": 0,
      "title": "Failed Nodes",
      "type": "integer"
    },
    "running_nodes": {
      "items": {
        "pattern": "^node_[0-9]{3}$",
        "type": "string"
      },
      "title": "Running Nodes",
      "type": "array"
    },
    "queued_nodes": {
      "items": {
        "pattern": "^node_[0-9]{3}$",
        "type": "string"
      },
      "title": "Queued Nodes",
      "type": "array"
    },
    "planning": {
      "default": false,
      "title": "Planning",
      "type": "boolean"
    },
    "research": {
      "title": "Research",
      "type": "object"
    }
  },
  "required": [
    "status",
    "task_sha256"
  ],
  "title": "RunReport",
  "type": "object"
}
