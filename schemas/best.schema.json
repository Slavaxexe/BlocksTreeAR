{
  "$defs": {
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "rmse",
            "macro_f1"
          ],
          "title": "Name",
          "type": "string"
        },
        "direction": {
          "enum": [
            "minimize",
            "maximize"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "required": [
        "name",
        "direction"
      ],
      "title": "Metric",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "node_id": {
      "pattern": "^node_[0-9]{3}$",
      "title": "Node Id",
      "type": "string"
    },
    "metric": {
      "$ref": "#/$defs/Metric"
    },
    "value": {
      "title": "Value",
      "type": "number"
    },
    "submission_file": {
      "title": "Submission File",
      "type": "string"
    },
    "split_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Split Sha256",
      "type": "string"
    }
  },
  "required": [
    "node_id",
    "metric",
    "value",
    "submission_file",
    "split_sha256"
  ],
  "title": "Best",
  "type": "object"
}
